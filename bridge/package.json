{
  "name": "dsh-vscode-panel-bridge",
  "version": "0.1.4",
  "description": "Local bridge that lets the dsh-vscode-panel VS Code extension drive DeepSeek Harness Desktop sessions",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "vscode"
  ],
  "license": "MIT"
}
